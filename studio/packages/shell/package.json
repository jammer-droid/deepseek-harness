{
  "name": "@local/dsh-studio-shell",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "workspace:*"
  }
}
