{
  "name": "@local/dsh-studio-sub-agent-catalog",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./src/types.ts"
    },
    "./tool": {
      "types": "./src/tool.ts",
      "default": "./tool.js"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "tool.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@local/dsh-studio-workflows": "workspace:*",
    "@deepseek-ai/dsh": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-goal": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-spill": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "zod": "4.4.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-subagent"
      ]
    }
  }
}
