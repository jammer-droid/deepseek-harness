{
  "name": "dsh-studio-development",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.mjs",
    "pack:bundle": "node pack.mjs",
    "watch": "node build.mjs --watch",
    "web": "npm run build && node start-web.mjs",
    "dev": "node dev.mjs",
    "dev:desktop": "node dev.mjs --desktop",
    "deploy": "node release/deploy.mjs",
    "release:github": "node release/deploy.mjs github",
    "release:npm": "node release/deploy.mjs npm"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-scope": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.19.0",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.27",
    "esbuild": "0.25.12",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "jsdom": "29.1.1"
  }
}
