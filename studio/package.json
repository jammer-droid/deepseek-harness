{
  "name": "dsh-studio-development",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.mjs",
    "pack:bundle": "node pack.mjs",
    "prepare:types": "pnpm --dir .. run build:lib:host && pnpm --dir .. exec tsc -b packages/client/ui-workspace packages/client/ui-renderer packages/client/ui-sidebar",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "esbuild": "0.25.12",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*"
  }
}
