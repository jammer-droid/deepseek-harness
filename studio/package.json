{
  "name": "dsh-studio-development",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node generate-roles.mjs && tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build": "npm run typecheck && node build.mjs",
    "build:desktop": "node build-desktop.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.mjs",
    "test:desktop": "node test/desktop/run.mjs",
    "test:browser": "vitest run --config test/vitest.browser.config.ts",
    "pack:bundle": "node pack.mjs",
    "deploy:web": "node deploy-web.mjs",
    "deploy:desktop": "node deploy-desktop.mjs",
    "prepare:types": "pnpm --dir .. run build:lib:host && pnpm --dir .. exec tsc -b packages/client/ui-workspace packages/client/ui-renderer packages/client/ui-sidebar packages/client/locale",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-typert-generator": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-json": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@local/dsh-studio-roles": "workspace:*",
    "zod": "4.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.27",
    "esbuild": "0.25.12",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-compaction": "workspace:*"
  }
}
